{% load static %}{
  "name": "Finde — eventos de Brasília",
  "short_name": "Finde",
  "description": "Shows, festivais, teatro e cultura em Brasília e no DF.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#faf8fc",
  "theme_color": "#150a1e",
  "lang": "pt-BR",
  "icons": [
    { "src": "{% static 'img/favicon-32.png' %}", "sizes": "32x32", "type": "image/png" },
    { "src": "{% static 'img/favicon-180.png' %}", "sizes": "180x180", "type": "image/png" },
    { "src": "{% static 'img/icone-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "{% static 'img/icone-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "{% static 'img/icone-512-maskable.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "categories": ["events", "entertainment", "travel"]
}
